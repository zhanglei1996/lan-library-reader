{
  "name": "lan-reader",
  "version": "0.7.1",
  "description": "A secure, read-only LAN reader for documents, text files and opt-in source code.",
  "license": "MIT",
  "keywords": [
    "markdown",
    "pdf",
    "document-viewer",
    "lan",
    "ebook",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanglei1996/lan-library-reader.git"
  },
  "homepage": "https://github.com/zhanglei1996/lan-library-reader#readme",
  "bugs": {
    "url": "https://github.com/zhanglei1996/lan-library-reader/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "server",
    "README.md",
    "ROADMAP.md",
    "LICENSE",
    "SECURITY.md",
    "RELEASING.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "lint": "eslint src server scripts tests",
    "release:check": "npm run test && npm run lint && npm audit --omit=dev --audit-level=high",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "^10.8.0",
    "github-slugger": "^2.0.0",
    "globals": "^16.3.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.16.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^8.1.5"
  },
  "type": "module",
  "bin": {
    "lan-reader": "server/index.mjs"
  }
}
